# Copy to .env.local for local development; set the same variables in Vercel → Project → Settings → Environment Variables.
# Never prefix secrets with NEXT_PUBLIC_ (those are exposed to the browser).

# Postgres connection string (required)
DATABASE_URL=

# Public site URL used for canonical links and emails (optional, defaults to https://slicedot.in)
NEXT_PUBLIC_SITE_URL=

# Set to 1 only on the real domain at go-live. Until then every page is noindex and robots.txt blocks all crawlers.
NEXT_PUBLIC_SITE_LIVE=

# Production shows the maintenance page unless this is off. Changing it needs a redeploy.
MAINTENANCE_MODE=
# The owner's way in during maintenance: visit /?preview=<token>. At least 24 characters, e.g.:

MAINTENANCE_BYPASS_TOKEN=

# The variables below are used from the step that ports each feature (see MIGRATION.md).

# SMTP: the info@slicedot.in mailbox sends contact alerts, OTP login codes and order emails.
# Check it with: node --env-file=.env.local scripts/test-mail.mjs --send
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Where store alerts go
ADMIN_EMAIL=
# Razorpay. Use rzp_test_ keys locally: outside production a live key is refused.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard webhook for payment.captured, pointing at <site>/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Customer and admin session signing key (required for sign-in). Any long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Vercel Blob (public store) for images uploaded in the admin and by customers
BLOB_READ_WRITE_TOKEN=

# AI writing help in the admin (product copy, SEO suggestions). Without it the AI buttons stay hidden.
ANTHROPIC_API_KEY=
# Free alternative for the admin's AI writing: a key from https://aistudio.google.com/apikey (used only when ANTHROPIC_API_KEY is empty)
GEMINI_API_KEY=

# Daily automation (/api/cron/daily via vercel.json): back-in-stock emails, bag reminders, low-stock note, clearing unpaid checkouts.
# Any long random string; Vercel Cron sends it automatically.
CRON_SECRET=
